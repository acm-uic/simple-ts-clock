# enable https (set to false for local development; true needs the certificates below)
HTTPS=true
SSL_KEY=/root/ssl/key.pem
SSL_CERT=/root/ssl/cert.pem
SSL_CA=/root/ssl/ca.pem
# The local path of where certificates are stored
TLS_DIR=./tls
# application port
PORT=8080
# api key for CTA trains
CTA_TRAIN_API_KEY=
# api key for CTA buses
CTA_BUS_API_KEY=
# Google API key restricted to the Calendar and Drive APIs (reads public calendars and the flyers folder)
GOOGLE_API_KEY=
# optional: GitHub token (fine-grained, public read-only) if the ticker hits GitHub's
# 60-requests-per-hour limit for unauthenticated requests
GITHUB_TOKEN=
# api key and secret for metra trains (not used yet)
METRA_TRAIN_ID=
METRA_TRAIN_SECRET=
